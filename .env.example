# Discord
DISCORD_BOT_TOKEN=replace_with_discord_bot_token

# YouTube Data API v3
YOUTUBE_API_KEY=replace_with_youtube_data_api_key
YOUTUBE_WEBSUB_SECRET=replace_with_random_secret

# Public HTTPS origin. Callback path /websub is appended by the bot.
YOUTUBE_CALLBACK_URL=https://y-api.suiten.site

# aiohttp callback listener (Cloudflare Tunnel -> this local address)
YOUTUBE_WEB_HOST=127.0.0.1
YOUTUBE_WEB_PORT=8765

# Local persistent database
YOUTUBE_DB_PATH=data/youtube_notice.sqlite3
